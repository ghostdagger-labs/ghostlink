GHOSTLINK_ORIGIN=http://127.0.0.1:3000
GHOSTLINK_DATABASE=.data/ghostlink.sqlite

# On Vercel, use the exact HTTPS site origin and a writable Neon primary.
# These values are server-only; never use NUXT_PUBLIC_ prefixes.
# DATABASE_URL=postgresql://...
GHOSTLINK_DATABASE_SCHEMA=ghostlink
# Optional owner connection for the explicit db:migrate command:
# MIGRATION_DATABASE_URL=postgresql://...
