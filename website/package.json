{
  "name": "ghostlink-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt prepare && nuxt typecheck && vue-tsc --noEmit -p tsconfig.snippets.json"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
