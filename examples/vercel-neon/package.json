{
  "name": "ghostlink-example-vercel-neon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build --webpack && node scripts/check-build.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@ghostdagger/ghostlink-core": "workspace:*",
    "@ghostdagger/ghostlink-react": "workspace:*",
    "@ghostdagger/ghostlink-server": "workspace:*",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/functions": "^3.11.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
