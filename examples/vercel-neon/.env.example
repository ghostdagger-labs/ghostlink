# Server-only Neon primary/pooled connection string. Never use NEXT_PUBLIC_ here.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.us-east-1.aws.neon.tech/DATABASE?sslmode=require
# Optional separate owner connection used only by db:migrate.
# MIGRATION_DATABASE_URL=postgresql://...
GHOSTLINK_DATABASE_SCHEMA=ghostlink
# Exact public origin, no trailing slash. Set your HTTPS domain on Vercel.
GHOSTLINK_ORIGIN=http://localhost:3200
# Explicit loopback development exception; ignored on Vercel.
GHOSTLINK_ALLOW_INSECURE_LOCALHOST=true
