{
  "name": "ghostlink-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter ghostlink-example-vue build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev": "pnpm --filter ghostlink-example-vue dev",
    "check:package": "node tools/check-packages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  }
}
