{
  "name": "ghostlink-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm build:website && pnpm --filter ghostlink-example-vue build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:postgres": "tsc -p tsconfig.postgres.json && vitest run --config vitest.postgres.config.ts",
    "test:vercel": "playwright test --config playwright.vercel.config.ts",
    "build:vercel": "pnpm --filter @ghostdagger/ghostlink-core build && pnpm --filter @ghostdagger/ghostlink-server build && pnpm --filter @ghostdagger/ghostlink-react build && pnpm --filter ghostlink-example-vercel-neon build",
    "test:browser": "playwright test",
    "dev": "pnpm --filter ghostlink-example-vue dev",
    "check:package": "node tools/check-packages.mjs",
    "check:guides": "node tools/check-integration-guides.mjs",
    "check:docs": "pnpm --filter ghostlink-website check:docs",
    "dev:website": "pnpm --filter ghostlink-website dev",
    "dev:vercel": "pnpm --filter ghostlink-example-vercel-neon dev",
    "build:website": "pnpm --filter ghostlink-website build",
    "test:website": "playwright test --config playwright.website.config.ts",
    "test:website:neon": "playwright test --config playwright.website-neon.config.ts",
    "test:release": "node --test tests/release/*.test.mjs",
    "release:prepare": "node tools/release.mjs",
    "release:verify": "node tools/release.mjs --mode verify",
    "release:dry-run": "node tools/release.mjs --mode dry-run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@neondatabase/serverless": "^1.2.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14",
    "ws": "^8.23.0"
  }
}
