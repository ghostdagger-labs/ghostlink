{
  "name": "@ghostdagger/ghostlink-vue",
  "version": "0.1.0-beta.2",
  "type": "module",
  "description": "Native Vue components for Ghostlink",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && tsup dist/index.d.ts --format esm --dts-only --out-dir .types && node ../../tools/finalize-vue-types.mjs",
    "typecheck": "vue-tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ghostdagger/ghostlink-core": "workspace:*",
    "@lucide/vue": "^1.76.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.45"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostdagger-labs/ghostlink.git",
    "directory": "packages/ghostlink-vue"
  },
  "homepage": "https://github.com/ghostdagger-labs/ghostlink#readme",
  "bugs": {
    "url": "https://github.com/ghostdagger-labs/ghostlink/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "candidate"
  }
}
