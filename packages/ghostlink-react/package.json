{
  "name": "@ghostdagger/ghostlink-react",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "Native React components for Ghostlink",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react --external react-dom",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ghostdagger/ghostlink-core": "workspace:*",
    "lucide-react": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostdagger-labs/ghostlink.git",
    "directory": "packages/ghostlink-react"
  },
  "homepage": "https://github.com/ghostdagger-labs/ghostlink#readme",
  "bugs": {
    "url": "https://github.com/ghostdagger-labs/ghostlink/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "candidate"
  }
}
