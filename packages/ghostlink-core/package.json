{
  "name": "@ghostdagger/ghostlink-core",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "Framework-neutral Kaspa wallet authentication and connection SDK",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./assets/*": "./dist/assets/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node ../../tools/copy-core-assets.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostdagger-labs/ghostlink.git",
    "directory": "packages/ghostlink-core"
  },
  "homepage": "https://github.com/ghostdagger-labs/ghostlink#readme",
  "bugs": {
    "url": "https://github.com/ghostdagger-labs/ghostlink/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "candidate"
  }
}
