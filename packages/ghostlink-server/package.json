{
  "name": "ghostlink-server", "version": "0.1.0", "type": "module",
  "description": "Server verification and revocable sessions for Ghostlink",
  "main": "./dist/index.js", "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "vendor", "README.md"], "sideEffects": false,
  "engines": { "node": ">=24 <25" },
  "scripts": { "build": "tsup src/index.ts --format esm --dts --clean", "typecheck": "tsc -p tsconfig.json" },
  "dependencies": { "ghostlink-core": "workspace:^" }
}
